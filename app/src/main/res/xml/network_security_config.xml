<?xml version="1.0" encoding="utf-8"?>
<!--
    O app usa HTTPS. HTTP sem criptografia só é liberado para o servidor de testes
    e para o servidor local de desenvolvimento (10.0.2.2 = computador, visto pelo emulador).
    Em produção, use sempre um endereço https://
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">190.102.41.159</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
