<?xml version="1.0" encoding="utf-8"?>
<!--
    O app usa HTTPS. HTTP sem criptografia só é liberado para o servidor atual do app (AppConfig.SERVER_URL).
    Ao passar para um endereço https://, remova esta exceção.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">190.102.41.159</domain>
    </domain-config>
</network-security-config>
