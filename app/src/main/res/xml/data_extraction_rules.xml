<?xml version="1.0" encoding="utf-8"?>
<!-- O token de acesso fica no DataStore "sessao": não vai para o backup nem para outro aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/sessao.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sessao.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
